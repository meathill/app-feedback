{
  "name": "app-feedback",
  "version": "0.3.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3010",
    "build": "next build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:migrate": "wrangler d1 migrations apply feedbacks --remote",
    "db:migrate:local": "wrangler d1 migrations apply feedbacks --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@google/genai": "^2.0.1",
    "@opennextjs/cloudflare": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.7.0",
    "next": "^16.2.2",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3",
    "wrangler": "^4.80.0"
  }
}
